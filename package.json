{
  "name": "racelink-overlays",
  "private": true,
  "description": "Racelink overlays in the R- and NFSMW- styles, each a standalone Racelink overlay project.",
  "type": "module",
  "workspaces": [
    "overlays/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "install-overlays": "node scripts/install-builds.mjs",
    "typecheck": "npm run typegen --workspaces && tsc -p tsconfig.json",
    "previews": "node scripts/gen-previews.mjs",
    "test": "node --experimental-strip-types --test \"racelink/src/**/*.test.ts\""
  },
  "engines": {
    "node": ">=22"
  }
}
