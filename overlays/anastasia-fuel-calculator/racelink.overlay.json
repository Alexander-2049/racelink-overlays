{
  "$schema": "./node_modules/@racelink/overlay/racelink-overlay.schema.json",
  "apiVersion": 2,
  "id": "anastasia-fuel-calculator",
  "version": "2.0.0",
  "name": "Anastasia Fuel Calculator",
  "category": "strategy",
  "description": "Fuel in the style of the board of twitch.tv/anastasia_striking, in her colours: fuel in the tank and laps in the race, then rows for the average of your last clean laps, your qualifying lap and your last lap (and a figure you type): fuel per lap, laps the tank lasts, fuel to add and fuel left at the flag. A PIT badge lights in the pit lane. Four themes, text colours that follow the theme or your own.",
  "entry": "index.html",
  "games": [
    "iracing",
    "le-mans-ultimate",
    "assetto-corsa",
    "assetto-corsa-competizione"
  ],
  "size": {
    "default": [
      500,
      238
    ],
    "min": [
      240,
      100
    ],
    "max": [
      1400,
      700
    ]
  },
  "settings": {
    "pages": [
      {
        "id": "look",
        "label": "Look",
        "groups": [
          {
            "settings": [
              {
                "key": "theme",
                "label": "Theme",
                "type": "select",
                "default": "ANASTASIA",
                "options": [
                  {
                    "value": "ANASTASIA",
                    "label": "Anastasia (violet and magenta)"
                  },
                  {
                    "value": "NEUTRAL",
                    "label": "Neutral dark"
                  },
                  {
                    "value": "MIDNIGHT",
                    "label": "Midnight blue"
                  },
                  {
                    "value": "ROSE",
                    "label": "Soft rose"
                  }
                ]
              },
              {
                "key": "fontSize",
                "label": "Size",
                "type": "number",
                "default": 15,
                "min": 8,
                "max": 48,
                "step": 1,
                "unit": "px"
              },
              {
                "key": "opacity",
                "label": "Background opacity",
                "type": "number",
                "default": 0.8,
                "min": 0,
                "max": 1,
                "step": 0.05
              },
              {
                "key": "radius",
                "label": "Corner radius",
                "type": "number",
                "default": 6,
                "min": 0,
                "max": 24,
                "step": 1,
                "unit": "px"
              },
              {
                "key": "accentLine",
                "label": "Accent line on top",
                "type": "boolean",
                "default": true
              },
              {
                "key": "animations",
                "label": "Animations",
                "type": "boolean",
                "default": true,
                "description": "Rows slide to their new place, cars and columns appear and leave smoothly. Off when the system asks for reduced motion."
              }
            ]
          },
          {
            "label": "Text colours",
            "settings": [
              {
                "key": "colorMode",
                "label": "Text colours",
                "type": "select",
                "default": "THEME",
                "options": [
                  {
                    "value": "THEME",
                    "label": "From the theme"
                  },
                  {
                    "value": "CUSTOM",
                    "label": "My colours"
                  }
                ]
              },
              {
                "key": "textColor",
                "label": "Text colour",
                "type": "color",
                "default": "#f6f1fd",
                "visibleIf": {
                  "colorMode": "CUSTOM"
                }
              },
              {
                "key": "goodColor",
                "label": "Accent colour (enough fuel, PIT)",
                "type": "color",
                "default": "#6ee7a8",
                "visibleIf": {
                  "colorMode": "CUSTOM"
                }
              },
              {
                "key": "badColor",
                "label": "Negative colour (not enough fuel)",
                "type": "color",
                "default": "#fb7185",
                "visibleIf": {
                  "colorMode": "CUSTOM"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "rows",
        "label": "Rows",
        "groups": [
          {
            "label": "Show",
            "settings": [
              {
                "key": "showLevel",
                "label": "Fuel level",
                "type": "boolean",
                "default": true
              },
              {
                "key": "showLapsInRace",
                "label": "Laps in the race",
                "type": "boolean",
                "default": true
              },
              {
                "key": "showPitBadge",
                "label": "PIT badge",
                "type": "boolean",
                "default": true
              },
              {
                "key": "showAverage",
                "label": "Average of the last clean laps",
                "type": "boolean",
                "default": true
              },
              {
                "key": "showQualify",
                "label": "Qualifying lap",
                "type": "boolean",
                "default": true
              },
              {
                "key": "showLast",
                "label": "Last lap",
                "type": "boolean",
                "default": true
              },
              {
                "key": "showCustom",
                "label": "My figure",
                "type": "boolean",
                "default": false
              },
              {
                "key": "myPerLap",
                "label": "My figure: fuel per lap, in the unit shown (0 is off)",
                "type": "number",
                "default": 0,
                "min": 0,
                "max": 500,
                "step": 0.01
              }
            ]
          },
          {
            "label": "Calculation",
            "settings": [
              {
                "key": "units",
                "label": "Unit",
                "type": "select",
                "default": "auto",
                "options": [
                  {
                    "value": "auto",
                    "label": "As in the game"
                  },
                  {
                    "value": "liters",
                    "label": "Litres"
                  },
                  {
                    "value": "usGallons",
                    "label": "US gallons"
                  },
                  {
                    "value": "imperialGallons",
                    "label": "Imperial gallons"
                  },
                  {
                    "value": "kilograms",
                    "label": "Kilograms"
                  }
                ]
              },
              {
                "key": "extraMode",
                "label": "Fuel at the end",
                "type": "select",
                "default": "spare",
                "options": [
                  {
                    "value": "spare",
                    "label": "Fuel left at the flag"
                  },
                  {
                    "value": "lapLess",
                    "label": "Fuel to add minus one lap"
                  },
                  {
                    "value": "lapMore",
                    "label": "Fuel to add plus one lap"
                  }
                ]
              },
              {
                "key": "cushion",
                "label": "Cushion added to a refuel of one unit or more",
                "type": "number",
                "default": 0.5,
                "min": 0,
                "max": 10,
                "step": 0.1
              },
              {
                "key": "warnLowFuel",
                "label": "Colour the level when two laps or less are left",
                "type": "boolean",
                "default": true
              }
            ]
          }
        ]
      }
    ]
  }
}
