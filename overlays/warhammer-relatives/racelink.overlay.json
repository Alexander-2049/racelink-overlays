{
  "$schema": "./node_modules/@racelink/overlay/racelink-overlay.schema.json",
  "apiVersion": 2,
  "id": "warhammer-relatives",
  "version": "1.0.0",
  "name": "Warhammer Relatives",
  "category": "race",
  "description": "Relatives in the style of Warhammer Racing's stream: the cars round the car you watch with their time to you, coloured by lap (a lap ahead, a lap behind, you), the last pit lap, safety rating and iRating, a strip of coolant and oil temperature, humidity, track temperature, strength of field, incidents and the clock, and a footer with the lap and the session clock.",
  "entry": "index.html",
  "games": [
    "iracing",
    "le-mans-ultimate",
    "assetto-corsa",
    "assetto-corsa-competizione"
  ],
  "size": {
    "default": [
      600,
      232
    ],
    "min": [
      300,
      80
    ],
    "max": [
      1800,
      1000
    ]
  },
  "settings": {
    "pages": [
      {
        "id": "look",
        "label": "Look",
        "groups": [
          {
            "settings": [
              {
                "key": "theme",
                "label": "Theme",
                "type": "select",
                "default": "ember",
                "options": [
                  {
                    "value": "ember",
                    "label": "Ember (Warhammer Racing)"
                  },
                  {
                    "value": "graphite",
                    "label": "Graphite (neutral dark)"
                  },
                  {
                    "value": "tide",
                    "label": "Tide (cool dark)"
                  },
                  {
                    "value": "clear",
                    "label": "Clear (almost no panel)"
                  }
                ]
              },
              {
                "key": "fontSize",
                "label": "Size",
                "type": "number",
                "default": 15,
                "min": 8,
                "max": 48,
                "step": 1,
                "unit": "px"
              },
              {
                "key": "opacity",
                "label": "Background opacity",
                "type": "number",
                "default": 0.82,
                "min": 0,
                "max": 1,
                "step": 0.05
              },
              {
                "key": "nameFormat",
                "label": "Driver name",
                "type": "select",
                "default": "firstLast",
                "options": [
                  {
                    "value": "initialLast",
                    "label": "F. Last"
                  },
                  {
                    "value": "firstLast",
                    "label": "First Last"
                  },
                  {
                    "value": "last",
                    "label": "Last"
                  },
                  {
                    "value": "lastInitial",
                    "label": "Last F."
                  },
                  {
                    "value": "firstInitial",
                    "label": "First L."
                  }
                ]
              },
              {
                "key": "rows",
                "label": "Rows",
                "type": "number",
                "default": 7,
                "min": 3,
                "max": 15,
                "step": 1
              }
            ]
          }
        ]
      },
      {
        "id": "columns",
        "label": "Columns",
        "groups": [
          {
            "label": "Strip above the rows",
            "settings": [
              {
                "key": "showHeader",
                "label": "Show the strip",
                "type": "boolean",
                "default": true
              },
              {
                "key": "headerItems",
                "label": "Strip items",
                "type": "order",
                "hideable": true,
                "items": [
                  {
                    "value": "waterTemp",
                    "label": "Coolant temperature"
                  },
                  {
                    "value": "oilTemp",
                    "label": "Oil temperature"
                  },
                  {
                    "value": "humidity",
                    "label": "Humidity"
                  },
                  {
                    "value": "trackTemp",
                    "label": "Track temperature"
                  },
                  {
                    "value": "airTemp",
                    "label": "Air temperature"
                  },
                  {
                    "value": "sof",
                    "label": "Strength of field"
                  },
                  {
                    "value": "incidents",
                    "label": "Incidents"
                  },
                  {
                    "value": "clock",
                    "label": "Clock"
                  }
                ],
                "default": [
                  "waterTemp",
                  "oilTemp",
                  "humidity",
                  "trackTemp",
                  {
                    "id": "airTemp",
                    "visible": false
                  },
                  "sof",
                  "incidents",
                  "clock"
                ]
              }
            ]
          },
          {
            "label": "Columns",
            "settings": [
              {
                "key": "columns",
                "label": "Columns",
                "type": "order",
                "hideable": true,
                "items": [
                  {
                    "value": "position",
                    "label": "Position"
                  },
                  {
                    "value": "number",
                    "label": "Car number"
                  },
                  {
                    "value": "name",
                    "label": "Name"
                  },
                  {
                    "value": "brand",
                    "label": "Make"
                  },
                  {
                    "value": "pitLap",
                    "label": "Lap of the last stop"
                  },
                  {
                    "value": "ratings",
                    "label": "Safety rating and iRating"
                  },
                  {
                    "value": "time",
                    "label": "Time to you"
                  }
                ],
                "default": [
                  "position",
                  "number",
                  "name",
                  {
                    "id": "brand",
                    "visible": false
                  },
                  "pitLap",
                  "ratings",
                  "time"
                ]
              }
            ]
          },
          {
            "label": "Footer",
            "settings": [
              {
                "key": "showFooter",
                "label": "Show the footer (lap and session clock)",
                "type": "boolean",
                "default": true
              }
            ]
          }
        ]
      },
      {
        "id": "cars",
        "label": "Cars",
        "groups": [
          {
            "label": "Which cars and how",
            "settings": [
              {
                "key": "colorByLap",
                "label": "Colour cars a lap ahead and a lap behind",
                "type": "boolean",
                "default": true
              },
              {
                "key": "showPit",
                "label": "Dim cars in the pit lane and mark them PIT",
                "type": "boolean",
                "default": true
              },
              {
                "key": "excludePit",
                "label": "Leave cars in the pit lane out",
                "type": "boolean",
                "default": false
              },
              {
                "key": "loneQualify",
                "label": "Hide other cars while you qualify alone",
                "type": "boolean",
                "default": true
              },
              {
                "key": "signedTime",
                "label": "Sign the time (+ behind, - ahead)",
                "type": "boolean",
                "default": false
              },
              {
                "key": "timeDecimals",
                "label": "Decimals of the time",
                "type": "number",
                "default": 1,
                "min": 0,
                "max": 3,
                "step": 1
              }
            ]
          }
        ]
      },
      {
        "id": "values",
        "label": "Values",
        "groups": [
          {
            "label": "Clock",
            "settings": [
              {
                "key": "clockMode",
                "label": "Session clock",
                "type": "select",
                "default": "remaining",
                "options": [
                  {
                    "value": "remaining",
                    "label": "Time left"
                  },
                  {
                    "value": "elapsed",
                    "label": "Time elapsed"
                  }
                ]
              },
              {
                "key": "lapDecimals",
                "label": "Decimals of the estimated laps",
                "type": "number",
                "default": 1,
                "min": 0,
                "max": 3,
                "step": 1
              },
              {
                "key": "clockSource",
                "label": "Clock in the strip",
                "type": "select",
                "default": "real",
                "options": [
                  {
                    "value": "real",
                    "label": "Real time"
                  },
                  {
                    "value": "game",
                    "label": "Time of day in the game"
                  }
                ]
              },
              {
                "key": "hour12",
                "label": "12 hour clock",
                "type": "boolean",
                "default": false
              }
            ]
          },
          {
            "label": "Ratings",
            "settings": [
              {
                "key": "showLicence",
                "label": "Safety rating pill",
                "type": "boolean",
                "default": true
              },
              {
                "key": "showIRating",
                "label": "iRating pill",
                "type": "boolean",
                "default": true
              },
              {
                "key": "licenceFormat",
                "label": "Safety rating format",
                "type": "select",
                "default": "classRating",
                "options": [
                  {
                    "value": "classRating",
                    "label": "A4.4"
                  },
                  {
                    "value": "rating",
                    "label": "4.4"
                  },
                  {
                    "value": "class",
                    "label": "A"
                  }
                ]
              },
              {
                "key": "iRatingFormat",
                "label": "iRating format",
                "type": "select",
                "default": "k",
                "options": [
                  {
                    "value": "k",
                    "label": "4.8k"
                  },
                  {
                    "value": "full",
                    "label": "4812"
                  }
                ]
              }
            ]
          },
          {
            "label": "Units",
            "settings": [
              {
                "key": "tempUnit",
                "label": "Temperature",
                "type": "select",
                "default": "auto",
                "options": [
                  {
                    "value": "auto",
                    "label": "As in the game"
                  },
                  {
                    "value": "celsius",
                    "label": "°C"
                  },
                  {
                    "value": "fahrenheit",
                    "label": "°F"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
