{
  "$schema": "./node_modules/@racelink/overlay/racelink-overlay.schema.json",
  "apiVersion": 2,
  "id": "driver-card",
  "version": "0.1.0",
  "name": "Driver Card",
  "category": "race",
  "description": "The driver you watch: country flag, full name, helmet in the colours picked in iRacing, and the car's custom paint with its number and decals (from Documents/iRacing/paint: Trading Paints or your own files).",
  "entry": "index.html",
  "games": ["iracing"],
  "size": { "default": [560, 220], "min": [220, 90], "max": [1600, 640] },
  "settings": {
    "pages": [
      {
        "id": "card",
        "label": "Card",
        "groups": [
          {
            "settings": [
              {
                "key": "driver",
                "label": "Driver",
                "type": "select",
                "default": "focused",
                "options": [
                  { "value": "focused", "label": "The car the camera follows" },
                  { "value": "player", "label": "You" }
                ]
              },
              { "key": "showFlag", "label": "Country flag", "type": "boolean", "default": true },
              { "key": "showHelmet", "label": "Helmet", "type": "boolean", "default": true },
              { "key": "showCar", "label": "Car", "type": "boolean", "default": true },
              {
                "key": "opacity",
                "label": "Background opacity",
                "type": "number",
                "default": 0.9,
                "min": 0,
                "max": 1,
                "step": 0.05
              }
            ]
          }
        ]
      }
    ]
  }
}
