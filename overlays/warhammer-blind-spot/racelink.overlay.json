{
  "$schema": "./node_modules/@racelink/overlay/racelink-overlay.schema.json",
  "apiVersion": 2,
  "id": "warhammer-blind-spot",
  "version": "1.0.0",
  "name": "Warhammer Blind Spot",
  "category": "awareness",
  "description": "A blind spot warning for the sides of the screen: a bar on the left and on the right lights while a car is alongside, and a line in it follows the car from behind to ahead. Two cars on one side fill the bar. Stretch the overlay across the view.",
  "entry": "index.html",
  "games": [
    "iracing",
    "le-mans-ultimate"
  ],
  "size": {
    "default": [
      900,
      260
    ],
    "min": [
      120,
      60
    ],
    "max": [
      3840,
      1400
    ]
  },
  "settings": {
    "pages": [
      {
        "id": "look",
        "label": "Look",
        "groups": [
          {
            "label": "Colours",
            "settings": [
              {
                "key": "theme",
                "label": "Theme",
                "type": "select",
                "default": "ember",
                "options": [
                  {
                    "value": "ember",
                    "label": "Ember (Warhammer Racing)"
                  },
                  {
                    "value": "graphite",
                    "label": "Graphite (neutral dark)"
                  },
                  {
                    "value": "tide",
                    "label": "Tide (cool dark)"
                  },
                  {
                    "value": "clear",
                    "label": "Clear (almost no panel)"
                  }
                ]
              },
              {
                "key": "opacity",
                "label": "Bar opacity",
                "type": "number",
                "default": 0.35,
                "min": 0,
                "max": 1,
                "step": 0.05
              }
            ]
          },
          {
            "label": "Bars",
            "settings": [
              {
                "key": "barWidth",
                "label": "Bar width",
                "type": "number",
                "default": 20,
                "min": 4,
                "max": 200,
                "step": 1,
                "unit": "px"
              },
              {
                "key": "lineWidth",
                "label": "Line width",
                "type": "number",
                "default": 10,
                "min": 2,
                "max": 200,
                "step": 1,
                "unit": "px"
              },
              {
                "key": "lineLength",
                "label": "Line length",
                "type": "number",
                "default": 35,
                "min": 5,
                "max": 100,
                "step": 1,
                "unit": "%"
              },
              {
                "key": "rounded",
                "label": "Round ends",
                "type": "boolean",
                "default": true
              },
              {
                "key": "smooth",
                "label": "Move smoothly",
                "type": "boolean",
                "default": true
              },
              {
                "key": "alwaysShowBars",
                "label": "Show the bars while nobody is alongside",
                "type": "boolean",
                "default": false
              }
            ]
          },
          {
            "label": "Reach",
            "settings": [
              {
                "key": "distAhead",
                "label": "Distance ahead",
                "type": "number",
                "default": 4,
                "min": 1,
                "max": 30,
                "step": 0.5,
                "unit": "m"
              },
              {
                "key": "distBehind",
                "label": "Distance behind",
                "type": "number",
                "default": 4,
                "min": 1,
                "max": 30,
                "step": 0.5,
                "unit": "m"
              }
            ]
          }
        ]
      }
    ]
  }
}
