{
  "$schema": "./node_modules/@racelink/overlay/racelink-overlay.schema.json",
  "apiVersion": 2,
  "id": "anastasia-relatives",
  "version": "1.1.0",
  "name": "Anastasia Relatives",
  "category": "race",
  "description": "The cars round you as on twitch.tv/anastasia_striking: the cars ahead above you, you in gold, the cars behind below. Position, number, name, laps since the pit stop (or PIT), licence, iRating and the time to you. A car a lap ahead of you (lapping you) is red, one a lap behind blue. Header with track and air temperature, strength of field, incidents and a clock. Columns and their order are settings. Four calm themes.",
  "entry": "index.html",
  "games": [
    "iracing",
    "le-mans-ultimate",
    "assetto-corsa"
  ],
  "size": {
    "default": [
      560,
      250
    ],
    "min": [
      240,
      60
    ],
    "max": [
      1400,
      900
    ]
  },
  "settings": {
    "pages": [
      {
        "id": "look",
        "label": "Look",
        "groups": [
          {
            "label": "Look",
            "settings": [
              {
                "key": "theme",
                "label": "Theme",
                "type": "select",
                "default": "ANASTASIA",
                "options": [
                  {
                    "value": "ANASTASIA",
                    "label": "Anastasia (violet and magenta)"
                  },
                  {
                    "value": "NEUTRAL",
                    "label": "Neutral dark"
                  },
                  {
                    "value": "MIDNIGHT",
                    "label": "Midnight blue"
                  },
                  {
                    "value": "ROSE",
                    "label": "Soft rose"
                  }
                ]
              },
              {
                "key": "fontSize",
                "label": "Size",
                "type": "number",
                "default": 15,
                "min": 8,
                "max": 48,
                "step": 1,
                "unit": "px"
              },
              {
                "key": "opacity",
                "label": "Background opacity",
                "type": "number",
                "default": 0.8,
                "min": 0,
                "max": 1,
                "step": 0.05
              },
              {
                "key": "radius",
                "label": "Corner radius",
                "type": "number",
                "default": 6,
                "min": 0,
                "max": 24,
                "step": 1,
                "unit": "px"
              },
              {
                "key": "accentLine",
                "label": "Accent line on top",
                "type": "boolean",
                "default": true
              },
              {
                "key": "animations",
                "label": "Animations",
                "type": "boolean",
                "default": true,
                "description": "Rows slide to their new place, cars and columns appear and leave smoothly. Off when the system asks for reduced motion."
              },
              {
                "key": "hideEmptyColumns",
                "label": "Hide empty columns",
                "type": "boolean",
                "default": true,
                "description": "A column with nothing in any row (no iRating offline, no pit stops yet) is left out; it opens when data arrives."
              }
            ]
          }
        ]
      },
      {
        "id": "rows",
        "label": "Rows",
        "groups": [
          {
            "label": "Cars",
            "settings": [
              {
                "key": "rows",
                "label": "Rows (you in the middle)",
                "type": "number",
                "default": 7,
                "min": 3,
                "max": 21,
                "step": 2
              },
              {
                "key": "excludePit",
                "label": "Hide cars in the pit lane",
                "type": "boolean",
                "default": false
              },
              {
                "key": "loneQualify",
                "label": "Hide other cars while you qualify alone",
                "type": "boolean",
                "default": true
              },
              {
                "key": "lapColors",
                "label": "Colour cars a lap ahead (red) or behind (blue)",
                "type": "boolean",
                "default": true
              },
              {
                "key": "nameFormat",
                "label": "Driver name",
                "type": "select",
                "default": "0",
                "options": [
                  {
                    "value": "0",
                    "label": "First Last"
                  },
                  {
                    "value": "2",
                    "label": "F. Last"
                  },
                  {
                    "value": "3",
                    "label": "Last F."
                  },
                  {
                    "value": "1",
                    "label": "Last First"
                  },
                  {
                    "value": "7",
                    "label": "Last"
                  },
                  {
                    "value": "10",
                    "label": "LAS (three letters)"
                  }
                ]
              },
              {
                "key": "gapDecimals",
                "label": "Decimals of the time",
                "type": "number",
                "default": 1,
                "min": 0,
                "max": 3,
                "step": 1
              }
            ]
          }
        ]
      },
      {
        "id": "columns",
        "label": "Columns",
        "groups": [
          {
            "label": "Columns and their order",
            "settings": [
              {
                "key": "columns",
                "label": "Columns",
                "type": "order",
                "hideable": true,
                "items": [
                  {
                    "value": "classStripe",
                    "label": "Class colour stripe"
                  },
                  {
                    "value": "position",
                    "label": "Position"
                  },
                  {
                    "value": "number",
                    "label": "Car number"
                  },
                  {
                    "value": "name",
                    "label": "Name"
                  },
                  {
                    "value": "flag",
                    "label": "Country flag"
                  },
                  {
                    "value": "brand",
                    "label": "Car brand"
                  },
                  {
                    "value": "pit",
                    "label": "Laps since the pit stop or PIT"
                  },
                  {
                    "value": "licence",
                    "label": "Licence"
                  },
                  {
                    "value": "rating",
                    "label": "iRating"
                  },
                  {
                    "value": "ratingChange",
                    "label": "iRating change (race)"
                  },
                  {
                    "value": "gap",
                    "label": "Time to you"
                  }
                ],
                "default": [
                  {
                    "id": "classStripe",
                    "visible": false
                  },
                  "position",
                  "number",
                  "name",
                  {
                    "id": "flag",
                    "visible": false
                  },
                  {
                    "id": "brand",
                    "visible": false
                  },
                  "pit",
                  "licence",
                  "rating",
                  {
                    "id": "ratingChange",
                    "visible": false
                  },
                  "gap"
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "header",
        "label": "Header",
        "groups": [
          {
            "label": "Header line",
            "settings": [
              {
                "key": "showHeader",
                "label": "Header",
                "type": "boolean",
                "default": true
              },
              {
                "key": "headerItems",
                "label": "Header items",
                "type": "order",
                "hideable": true,
                "visibleIf": {
                  "showHeader": true
                },
                "items": [
                  {
                    "value": "trackTemp",
                    "label": "Track temperature"
                  },
                  {
                    "value": "airTemp",
                    "label": "Air temperature"
                  },
                  {
                    "value": "sof",
                    "label": "Strength of field"
                  },
                  {
                    "value": "incidents",
                    "label": "Incidents"
                  },
                  {
                    "value": "clock",
                    "label": "Clock"
                  }
                ],
                "default": [
                  "trackTemp",
                  "airTemp",
                  "sof",
                  "incidents",
                  "clock"
                ]
              },
              {
                "key": "temperatureUnit",
                "label": "Temperature",
                "type": "select",
                "default": "AUTO",
                "visibleIf": {
                  "showHeader": true
                },
                "options": [
                  {
                    "value": "AUTO",
                    "label": "As the game"
                  },
                  {
                    "value": "C",
                    "label": "Celsius"
                  },
                  {
                    "value": "F",
                    "label": "Fahrenheit"
                  }
                ]
              },
              {
                "key": "clockSource",
                "label": "Clock shows",
                "type": "select",
                "default": "REAL",
                "visibleIf": {
                  "showHeader": true
                },
                "options": [
                  {
                    "value": "REAL",
                    "label": "The time of day on this computer"
                  },
                  {
                    "value": "GAME",
                    "label": "The time of day in the game"
                  }
                ]
              },
              {
                "key": "clock12h",
                "label": "12-hour clock",
                "type": "boolean",
                "default": false,
                "visibleIf": {
                  "showHeader": true
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
