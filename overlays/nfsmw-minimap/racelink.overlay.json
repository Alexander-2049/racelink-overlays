{
  "$schema": "./node_modules/@racelink/overlay/racelink-overlay.schema.json",
  "apiVersion": 2,
  "id": "nfsmw-minimap",
  "version": "1.0.0",
  "name": "NFSMW-Minimap",
  "category": "awareness",
  "description": "NFSMW-Minimap, the Racelink overlay, as a standalone overlay.",
  "entry": "index.html",
  "games": [
    "iracing"
  ],
  "size": {
    "default": [
      372,
      374
    ],
    "min": [
      60,
      30
    ],
    "max": [
      1488,
      1496
    ]
  },
  "settings": {
    "pages": [
      {
        "id": "general",
        "label": "General",
        "groups": [
          {
            "settings": [
              {
                "key": "visibleRadiusMeters",
                "label": "Map radius",
                "type": "number",
                "default": 250,
                "min": 50,
                "max": 1000,
                "step": 10,
                "unit": "m"
              },
              {
                "key": "showTerrain",
                "label": "Terrain around the track",
                "type": "boolean",
                "default": true,
                "description": "Tarmac and water from the track map, in the game map colours."
              },
              {
                "key": "showOpponents",
                "label": "Opponents",
                "type": "boolean",
                "default": true
              },
              {
                "key": "showStartLine",
                "label": "Start line",
                "type": "boolean",
                "default": true
              }
            ]
          }
        ]
      }
    ]
  },
  "workshop": {
    "tags": [
      "Inputs"
    ],
    "visibility": "public"
  }
}
