{
  "$schema": "./node_modules/@racelink/overlay/racelink-overlay.schema.json",
  "apiVersion": 2,
  "id": "nfsmw-leaderboard",
  "version": "1.0.0",
  "name": "NFSMW-Leaderboard",
  "category": "race",
  "description": "NFSMW-Leaderboard, the Racelink overlay, as a standalone overlay.",
  "entry": "index.html",
  "games": [
    "iracing",
    "le-mans-ultimate",
    "assetto-corsa"
  ],
  "size": {
    "default": [
      450,
      324
    ],
    "min": [
      60,
      30
    ],
    "max": [
      1800,
      1296
    ]
  },
  "settings": {
    "pages": [
      {
        "id": "general",
        "label": "General",
        "groups": [
          {
            "settings": [
              {
                "key": "positionMode",
                "label": "Position",
                "type": "select",
                "default": "overall",
                "options": [
                  {
                    "value": "overall",
                    "label": "Overall"
                  },
                  {
                    "value": "class",
                    "label": "In class"
                  }
                ],
                "description": "In class: positions and opponents of your class only."
              },
              {
                "key": "nameFormat",
                "label": "Driver name",
                "type": "select",
                "default": "last",
                "options": [
                  {
                    "value": "last",
                    "label": "Last name"
                  },
                  {
                    "value": "first",
                    "label": "First name"
                  },
                  {
                    "value": "full",
                    "label": "In full"
                  }
                ]
              },
              {
                "key": "units",
                "label": "Distance to opponents",
                "type": "select",
                "default": "auto",
                "options": [
                  {
                    "value": "auto",
                    "label": "As in the game"
                  },
                  {
                    "value": "metric",
                    "label": "Metres"
                  },
                  {
                    "value": "imperial",
                    "label": "Feet"
                  }
                ],
                "description": "Rows take turns showing names and the distance to them."
              }
            ]
          }
        ]
      }
    ]
  },
  "workshop": {
    "tags": [
      "Inputs"
    ],
    "visibility": "public"
  }
}
