{
  "$schema": "./node_modules/@racelink/overlay/racelink-overlay.schema.json",
  "apiVersion": 2,
  "id": "gt4-gauges",
  "version": "1.1.0",
  "name": "GT4 Gauges",
  "category": "driving",
  "description": "Twin speedometer and tachometer in the style of a classic console racing game: needles, redline, gear and speed in the middle, pedal and fuel arcs, and a lateral G bar.\n\nThe gear box flashes at the shift point, the speed unit turns into PIT while the pit limiter is on, and the odometer shows the distance the car has driven in all your sessions, or since the overlay opened.\n\nCredits\n- Font: Michroma by The Michroma Project Authors (https://github.com/googlefonts/Michroma-font), SIL Open Font License 1.1.",
  "entry": "index.html",
  "games": [
    "iracing",
    "le-mans-ultimate",
    "assetto-corsa",
    "assetto-corsa-evo",
    "assetto-corsa-rally"
  ],
  "size": {
    "default": [
      960,
      360
    ],
    "min": [
      240,
      90
    ],
    "max": [
      1920,
      720
    ]
  },
  "settings": {
    "pages": [
      {
        "id": "display",
        "label": "Display",
        "groups": [
          {
            "label": "Speed",
            "settings": [
              {
                "key": "speedUnit",
                "label": "Speed unit",
                "type": "select",
                "default": "auto",
                "options": [
                  {
                    "value": "auto",
                    "label": "As in the game"
                  },
                  {
                    "value": "kph",
                    "label": "km/h"
                  },
                  {
                    "value": "mph",
                    "label": "mph"
                  }
                ]
              },
              {
                "key": "speedScale",
                "label": "Speedometer scale",
                "type": "select",
                "default": "auto",
                "options": [
                  {
                    "value": "auto",
                    "label": "Automatic (grows with the car)"
                  },
                  {
                    "value": "160",
                    "label": "0–160"
                  },
                  {
                    "value": "200",
                    "label": "0–200"
                  },
                  {
                    "value": "240",
                    "label": "0–240"
                  },
                  {
                    "value": "280",
                    "label": "0–280"
                  },
                  {
                    "value": "320",
                    "label": "0–320"
                  },
                  {
                    "value": "360",
                    "label": "0–360"
                  },
                  {
                    "value": "400",
                    "label": "0–400"
                  }
                ],
                "description": "In the speed unit shown. Automatic starts at 280 km/h (160 mph) and widens when the car goes faster."
              },
              {
                "key": "odometer",
                "label": "Odometer",
                "type": "select",
                "default": "total",
                "options": [
                  {
                    "value": "total",
                    "label": "Distance the car has driven"
                  },
                  {
                    "value": "trip",
                    "label": "Distance since the overlay opened"
                  },
                  {
                    "value": "off",
                    "label": "Hidden"
                  }
                ]
              },
              {
                "key": "pitLimiter",
                "label": "PIT in place of the unit while the pit limiter is on",
                "type": "boolean",
                "default": true
              }
            ]
          },
          {
            "label": "Tachometer",
            "settings": [
              {
                "key": "redline",
                "label": "Red zone",
                "type": "select",
                "default": "shift",
                "options": [
                  {
                    "value": "shift",
                    "label": "From the shift point of the car"
                  },
                  {
                    "value": "limit",
                    "label": "Last 1000 rpm before the limiter"
                  },
                  {
                    "value": "off",
                    "label": "None"
                  }
                ]
              },
              {
                "key": "shiftFlash",
                "label": "Gear flashes at the shift point",
                "type": "boolean",
                "default": true
              },
              {
                "key": "shiftFlashColor",
                "label": "Flash colour",
                "type": "color",
                "default": "#FF2A22",
                "visibleIf": {
                  "shiftFlash": true
                }
              }
            ]
          },
          {
            "label": "G-forces",
            "settings": [
              {
                "key": "maxGForce",
                "label": "Scale",
                "type": "number",
                "default": 2,
                "min": 1,
                "max": 5,
                "step": 0.5,
                "unit": "g"
              },
              {
                "key": "invertGForce",
                "label": "Ball moves into the corner",
                "type": "boolean",
                "default": false,
                "description": "Off: the ball is pushed out of the corner, as a body feels it."
              }
            ]
          }
        ]
      },
      {
