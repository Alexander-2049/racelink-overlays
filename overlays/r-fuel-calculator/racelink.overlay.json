{
  "$schema": "./node_modules/@racelink/overlay/racelink-overlay.schema.json",
  "apiVersion": 2,
  "id": "r-fuel-calculator",
  "version": "1.0.0",
  "name": "R-Fuel Calculator",
  "category": "strategy",
  "description": "R-Fuel Calculator, the Racelink overlay, as a standalone overlay.",
  "entry": "index.html",
  "games": [
    "iracing",
    "le-mans-ultimate",
    "assetto-corsa"
  ],
  "size": {
    "default": [
      560,
      192
    ],
    "min": [
      60,
      30
    ],
    "max": [
      2240,
      768
    ]
  },
  "settings": {
    "pages": [
      {
        "id": "general",
        "label": "General",
        "groups": [
          {
            "settings": [
              {
                "key": "Opacity",
                "label": "Background opacity",
                "type": "number",
                "default": 0.8,
                "min": 0,
                "max": 1,
                "step": 0.05
              },
              {
                "key": "FontFamily",
                "label": "Font",
                "type": "select",
                "default": "Montserrat",
                "options": [
                  {
                    "value": "Montserrat",
                    "label": "Montserrat"
                  },
                  {
                    "value": "Roboto",
                    "label": "Roboto"
                  },
                  {
                    "value": "RobotoMono",
                    "label": "Roboto Mono"
                  },
                  {
                    "value": "TitilliumWeb",
                    "label": "Titillium Web"
                  },
                  {
                    "value": "Exo2",
                    "label": "Exo 2"
                  },
                  {
                    "value": "BarlowCondensed",
                    "label": "Barlow Condensed"
                  },
                  {
                    "value": "JetBrainsMono",
                    "label": "JetBrains Mono"
                  },
                  {
                    "value": "Geist",
                    "label": "Geist"
                  }
                ]
              },
              {
                "key": "FontWeight",
                "label": "Weight",
                "type": "select",
                "default": "Semibold",
                "options": [
                  {
                    "value": "Regular",
                    "label": "Regular"
                  },
                  {
                    "value": "Medium",
                    "label": "Medium"
                  },
                  {
                    "value": "Semibold",
                    "label": "Semibold"
                  },
                  {
                    "value": "Bold",
                    "label": "Bold"
                  },
                  {
                    "value": "Extra",
                    "label": "Extra bold"
                  }
                ]
              },
              {
                "key": "ShowTitle",
                "label": "Overlay header",
                "type": "boolean",
                "default": true
              },
              {
                "key": "OverlayTitleColor",
                "label": "Header colour",
                "type": "color",
                "default": "#d10404",
                "visibleIf": {
                  "ShowTitle": true
                }
              },
              {
                "key": "DecimalCount",
                "label": "Decimal places",
                "type": "number",
                "default": 1,
                "min": 0,
                "max": 3,
                "step": 1
              },
              {
                "key": "ShowFuelBar",
                "label": "Fuel gauge",
                "type": "boolean",
                "default": true
              },
              {
                "key": "ShowFuel",
                "label": "Fuel amount",
                "type": "boolean",
                "default": true
              },
              {
                "key": "ShowFuelHistory",
                "label": "Consumption history",
                "type": "boolean",
                "default": true
              },
              {
                "key": "FuelHistoryOpacity",
                "label": "Fuel history opacity",
                "type": "number",
                "default": 0.5,
                "min": 0,
                "max": 1,
                "step": 0.05,
                "visibleIf": {
                  "ShowFuelHistory": true
                }
              },
              {
                "key": "ShowTimeRemainingUntilEmpty",
                "label": "Time on fuel",
                "type": "boolean",
                "default": false,
                "description": "How long the fuel in the tank lasts."
              },
              {
                "key": "ShowTimeRemainingUntilEmptyTarget",
                "label": "Target time on fuel",
                "type": "boolean",
                "default": true,
                "description": "Fuel time surplus or shortfall to the end of the session: plus means enough fuel to spare, minus means not enough.",
                "visibleIf": {
                  "ShowTimeRemainingUntilEmpty": true
                }
              },
              {
                "key": "ShowLapsRemainingUntilEmpty",
                "label": "Laps to empty",
                "type": "boolean",
                "default": false
              },
              {
                "key": "ShowLapsRemainingUntilEmptyTarget",
                "label": "Lap target",
                "type": "boolean",
                "default": true,
                "visibleIf": {
                  "ShowLapsRemainingUntilEmpty": true
                }
              }
            ]
          }
        ]
      },
      {
        "id": "strategies",
        "label": "Refuel strategies",
        "groups": [
          {
            "label": "Consumption rows",
            "settings": [
              {
                "key": "ShowAllLapsAverage",
                "label": "Average consumption of all laps",
                "type": "boolean",
                "default": true,
                "description": "Consumption by the average of all session laps."
              },
              {
                "key": "AllLapsAverageColor",
                "label": "Colour: Avg",
                "type": "color",
                "default": "#ffffff",
                "visibleIf": {
                  "ShowAllLapsAverage": true
                }
              },
              {
                "key": "ShowHighestLap",
                "label": "Highest consumption",
                "type": "boolean",
                "default": true,
                "description": "Consumption of the session lap that used the most."
              },
              {
                "key": "HighestLapColor",
                "label": "Colour: Max",
                "type": "color",
                "default": "#ffffff",
                "visibleIf": {
                  "ShowHighestLap": true
                }
              },
              {
                "key": "ShowLowestLap",
                "label": "Lowest consumption",
                "type": "boolean",
                "default": true,
                "description": "Consumption of the session lap that used the least."
              },
              {
                "key": "LowestLapColor",
                "label": "Colour: Min",
                "type": "color",
                "default": "#ffffff",
                "visibleIf": {
                  "ShowLowestLap": true
                }
              },
              {
                "key": "ShowLastLap",
                "label": "Last lap",
                "type": "boolean",
                "default": false,
                "description": "Consumption of the last session lap."
              },
              {
                "key": "LastLapColor",
                "label": "Colour: Last",
                "type": "color",
                "default": "#ffffff",
                "visibleIf": {
                  "ShowLastLap": true
                }
              },
              {
                "key": "ShowLast5Average",
                "label": "Avg. of the last 5 laps",
                "type": "boolean",
                "default": false,
                "description": "Consumption by the average of the last 5 session laps."
              },
              {
                "key": "Last5AverageColor",
                "label": "Colour: L5",
                "type": "color",
                "default": "#ffffff",
                "visibleIf": {
                  "ShowLast5Average": true
                }
              },
              {
                "key": "ShowLast10Average",
                "label": "Avg. of the last 10 laps",
                "type": "boolean",
                "default": false,
                "description": "Consumption by the average of the last 10 session laps."
              },
              {
                "key": "Last10AverageColor",
                "label": "Colour: L10",
                "type": "color",
                "default": "#ffffff",
                "visibleIf": {
                  "ShowLast10Average": true
                }
              }
            ]
          }
        ]
      },
      {
        "id": "columns",
        "label": "Consumption columns",
        "groups": [
          {
            "settings": [
              {
                "key": "ShowAverageFuel",
                "label": "Consumption",
                "type": "boolean",
                "default": true
              },
              {
                "key": "ShowLaps",
                "label": "Laps left",
                "type": "boolean",
                "default": true
              },
              {
                "key": "ShowTotalPitstops",
                "label": "Total pit stops",
                "type": "boolean",
                "default": false
              },
              {
                "key": "ShowRefuel",
                "label": "Amount to refuel",
                "type": "boolean",
                "default": true
              },
              {
                "key": "ShowTotalRefuel",
                "label": "Total fuel to add",
                "type": "boolean",
                "default": false
              },
              {
                "key": "ShowFuelAtEnd",
                "label": "Fuel at the finish",
                "type": "boolean",
                "default": true
              }
            ]
          }
        ]
      },
      {
        "id": "refueling",
        "label": "Refuel",
        "groups": [
          {
            "settings": [
              {
                "key": "RefuelingStrategy",
                "label": "Refuel strategy in use",
                "type": "select",
                "default": "Last10Average",
                "options": [
                  {
                    "value": "AllLapsAverage",
                    "label": "Average consumption of all laps"
                  },
                  {
                    "value": "HighestLap",
                    "label": "Highest consumption"
                  },
                  {
                    "value": "LowestLap",
                    "label": "Lowest consumption"
                  },
                  {
                    "value": "LastLap",
                    "label": "Last lap"
                  },
                  {
                    "value": "Last5Average",
                    "label": "Avg. of the last 5 laps"
                  },
                  {
                    "value": "Last10Average",
                    "label": "Avg. of the last 10 laps"
                  }
                ]
              },
              {
                "key": "RefuelAdditionalFuelInLaps",
                "label": "Extra fuel (per lap)",
                "type": "number",
                "default": 1.2,
                "min": 0,
                "max": 5,
                "step": 0.1,
                "description": "Refuel margin, in laps of consumption."
              },
              {
                "key": "ShowFuelWindowBar",
                "label": "Refuel window",
                "type": "boolean",
                "default": false,
                "description": "A strip of the race laps ahead: each tick is a lap, green ones are laps when you can pit to refuel, yellow is the current one."
              },
              {
                "key": "ShowFuelWindowStatus",
                "label": "Refuel window status",
                "type": "boolean",
                "default": false,
                "description": "Refuel window status for the chosen strategy."
              }
            ]
          }
        ]
      }
    ]
  },
  "workshop": {
    "tags": [
      "Inputs"
    ],
    "visibility": "public",
    "publishedFileId": "3828526726"
  }
}
