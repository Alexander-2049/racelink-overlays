{
  "$schema": "./node_modules/@racelink/overlay/racelink-overlay.schema.json",
  "apiVersion": 2,
  "id": "r-boost-box",
  "version": "1.0.0",
  "name": "R-Boost Box",
  "category": "strategy",
  "description": "R-Boost Box, the Racelink overlay, as a standalone overlay.",
  "entry": "index.html",
  "games": [
    "iracing",
    "le-mans-ultimate",
    "assetto-corsa"
  ],
  "size": {
    "default": [
      260,
      90
    ],
    "min": [
      60,
      30
    ],
    "max": [
      1040,
      360
    ]
  },
  "settings": {
    "pages": [
      {
        "id": "general",
        "label": "Основное",
        "groups": [
          {
            "settings": [
              {
                "key": "Opacity",
                "label": "Непрозрачность фона",
                "type": "number",
                "default": 0.8,
                "min": 0,
                "max": 1,
                "step": 0.05
              },
              {
                "key": "FontFamily",
                "label": "Шрифт",
                "type": "select",
                "default": "Montserrat",
                "options": [
                  {
                    "value": "Montserrat",
                    "label": "Montserrat"
                  },
                  {
                    "value": "Roboto",
                    "label": "Roboto"
                  },
                  {
                    "value": "RobotoMono",
                    "label": "Roboto Mono"
                  },
                  {
                    "value": "TitilliumWeb",
                    "label": "Titillium Web"
                  },
                  {
                    "value": "Exo2",
                    "label": "Exo 2"
                  },
                  {
                    "value": "BarlowCondensed",
                    "label": "Barlow Condensed"
                  },
                  {
                    "value": "JetBrainsMono",
                    "label": "JetBrains Mono"
                  },
                  {
                    "value": "Geist",
                    "label": "Geist"
                  }
                ]
              },
              {
                "key": "FontWeight",
                "label": "Толщина",
                "type": "select",
                "default": "Semibold",
                "options": [
                  {
                    "value": "Regular",
                    "label": "Обычный"
                  },
                  {
                    "value": "Medium",
                    "label": "Средний"
                  },
                  {
                    "value": "Semibold",
                    "label": "Полужирный"
                  },
                  {
                    "value": "Bold",
                    "label": "Жирный"
                  },
                  {
                    "value": "Extra",
                    "label": "Сверхжирный"
                  }
                ]
              },
              {
                "key": "ShowTitle",
                "label": "Заголовок оверлея",
                "type": "boolean",
                "default": true
              },
              {
                "key": "OverlayTitleColor",
                "label": "Цвет заголовка",
                "type": "color",
                "default": "#d10404",
                "visibleIf": {
                  "ShowTitle": true
                }
              },
              {
                "key": "ShowLastLapInfoBox",
                "label": "Время последнего круга",
                "type": "boolean",
                "default": true
              }
            ]
          }
        ]
      }
    ]
  },
  "workshop": {
    "tags": [
      "Inputs"
    ],
    "visibility": "public"
  }
}
