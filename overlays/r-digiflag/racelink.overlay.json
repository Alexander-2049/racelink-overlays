{
  "$schema": "./node_modules/@racelink/overlay/racelink-overlay.schema.json",
  "apiVersion": 2,
  "id": "r-digiflag",
  "version": "1.0.0",
  "name": "R-Digiflag",
  "category": "race",
  "description": "R-Digiflag, the Racelink overlay, as a standalone overlay.",
  "entry": "index.html",
  "games": [
    "iracing",
    "le-mans-ultimate",
    "assetto-corsa"
  ],
  "size": {
    "default": [
      210,
      210
    ],
    "min": [
      60,
      30
    ],
    "max": [
      840,
      840
    ]
  },
  "settings": {
    "pages": [
      {
        "id": "general",
        "label": "General",
        "groups": [
          {
            "settings": [
              {
                "key": "Type",
                "label": "Type",
                "type": "select",
                "default": "big",
                "options": [
                  {
                    "value": "big",
                    "label": "Large"
                  },
                  {
                    "value": "small",
                    "label": "Small"
                  },
                  {
                    "value": "doublestrip",
                    "label": "Two bars"
                  }
                ]
              },
              {
                "key": "HideWhenNoFlag",
                "label": "Hide when inactive",
                "type": "boolean",
                "default": false
              },
              {
                "key": "ShowFlagInPreview",
                "label": "Preview flag",
                "description": "The flag shown in demo mode and while arranging overlays.",
                "type": "select",
                "default": "green",
                "options": [
                  {
                    "value": "checkered",
                    "label": "Chequered"
                  },
                  {
                    "value": "white",
                    "label": "White"
                  },
                  {
                    "value": "green",
                    "label": "Green"
                  },
                  {
                    "value": "yellow",
                    "label": "Yellow"
                  },
                  {
                    "value": "red",
                    "label": "Red"
                  },
                  {
                    "value": "blue",
                    "label": "Blue"
                  },
                  {
                    "value": "debris",
                    "label": "Debris"
                  },
                  {
                    "value": "crossed",
                    "label": "Crossed"
                  },
                  {
                    "value": "oneLapToGreen",
                    "label": "One lap to green"
                  },
                  {
                    "value": "tenToGo",
                    "label": "10 laps to go"
                  },
                  {
                    "value": "fiveToGo",
                    "label": "5 laps to go"
                  },
                  {
                    "value": "randomWaving",
                    "label": "Random"
                  },
                  {
                    "value": "caution",
                    "label": "Caution"
                  },
                  {
                    "value": "black",
                    "label": "Black"
                  },
                  {
                    "value": "disqualify",
                    "label": "Disqualification"
                  },
                  {
                    "value": "furled",
                    "label": "Cut track"
                  },
                  {
                    "value": "repair",
                    "label": "Mandatory repair"
                  },
                  {
                    "value": "startReady",
                    "label": "Start: get ready"
                  },
                  {
                    "value": "startSet",
                    "label": "Start: set"
                  },
                  {
                    "value": "startGo",
                    "label": "Start: go"
                  }
                ]
              }
            ]
          },
          {
            "label": "Bar settings",
            "settings": [
              {
                "key": "DoubleStripDistance",
                "label": "Spacing",
                "type": "number",
                "default": 200,
                "min": 0,
                "max": 1000,
                "step": 1,
                "unit": "px",
                "visibleIf": {
                  "Type": "doublestrip"
                }
              }
            ]
          },
          {
            "label": "Look",
            "settings": [
              {
                "key": "FontSize",
                "label": "Size",
                "type": "number",
                "default": 14,
                "min": 6,
                "max": 60,
                "step": 1,
                "unit": "px"
              },
              {
                "key": "Opacity",
                "label": "Background opacity",
                "type": "number",
                "default": 0.8,
                "min": 0,
                "max": 1,
                "step": 0.05
              },
              {
                "key": "FontFamily",
                "label": "Font",
                "type": "select",
                "default": "Montserrat",
                "options": [
                  {
                    "value": "Montserrat",
                    "label": "Montserrat"
                  },
                  {
                    "value": "Roboto",
                    "label": "Roboto"
                  },
                  {
                    "value": "RobotoMono",
                    "label": "Roboto Mono"
                  },
                  {
                    "value": "TitilliumWeb",
                    "label": "Titillium Web"
                  },
                  {
                    "value": "Exo2",
                    "label": "Exo 2"
                  },
                  {
                    "value": "BarlowCondensed",
                    "label": "Barlow Condensed"
                  },
                  {
                    "value": "JetBrainsMono",
                    "label": "JetBrains Mono"
                  },
                  {
                    "value": "Geist",
                    "label": "Geist"
                  }
                ]
              },
              {
                "key": "FontWeight",
                "label": "Weight",
                "type": "select",
                "default": "Semibold",
                "options": [
                  {
                    "value": "Regular",
                    "label": "Regular"
                  },
                  {
                    "value": "Medium",
                    "label": "Medium"
                  },
                  {
                    "value": "Semibold",
                    "label": "Semibold"
                  },
                  {
                    "value": "Bold",
                    "label": "Bold"
                  },
                  {
                    "value": "Extra",
                    "label": "Extra bold"
                  }
                ]
              },
              {
                "key": "ShowTitle",
                "label": "Overlay header",
                "type": "boolean",
                "default": false
              },
              {
                "key": "OverlayTitleColor",
                "label": "Header colour",
                "type": "color",
                "default": "#d10404",
                "visibleIf": {
                  "ShowTitle": true
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "workshop": {
    "tags": [
      "Inputs"
    ],
    "visibility": "public"
  }
}
