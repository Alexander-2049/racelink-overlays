{
  "$schema": "./node_modules/@racelink/overlay/racelink-overlay.schema.json",
  "apiVersion": 2,
  "id": "r-pitbox-helper",
  "version": "1.0.0",
  "name": "R-Pitbox Helper",
  "category": "strategy",
  "description": "R-Pitbox Helper, the Racelink overlay, as a standalone overlay.",
  "entry": "index.html",
  "games": [
    "iracing",
    "le-mans-ultimate"
  ],
  "size": {
    "default": [
      166,
      230
    ],
    "min": [
      60,
      30
    ],
    "max": [
      664,
      920
    ]
  },
  "settings": {
    "pages": [
      {
        "id": "general",
        "label": "Основное",
        "groups": [
          {
            "settings": [
              {
                "key": "Opacity",
                "label": "Непрозрачность фона",
                "type": "number",
                "default": 0.6,
                "min": 0,
                "max": 1,
                "step": 0.05
              },
              {
                "key": "FontFamily",
                "label": "Шрифт",
                "type": "select",
                "default": "Montserrat",
                "options": [
                  {
                    "value": "Montserrat",
                    "label": "Montserrat"
                  },
                  {
                    "value": "Roboto",
                    "label": "Roboto"
                  },
                  {
                    "value": "RobotoMono",
                    "label": "Roboto Mono"
                  },
                  {
                    "value": "TitilliumWeb",
                    "label": "Titillium Web"
                  },
                  {
                    "value": "Exo2",
                    "label": "Exo 2"
                  },
                  {
                    "value": "BarlowCondensed",
                    "label": "Barlow Condensed"
                  },
                  {
                    "value": "JetBrainsMono",
                    "label": "JetBrains Mono"
                  },
                  {
                    "value": "Geist",
                    "label": "Geist"
                  }
                ]
              },
              {
                "key": "FontWeight",
                "label": "Толщина",
                "type": "select",
                "default": "Semibold",
                "options": [
                  {
                    "value": "Regular",
                    "label": "Обычный"
                  },
                  {
                    "value": "Medium",
                    "label": "Средний"
                  },
                  {
                    "value": "Semibold",
                    "label": "Полужирный"
                  },
                  {
                    "value": "Bold",
                    "label": "Жирный"
                  },
                  {
                    "value": "Extra",
                    "label": "Сверхжирный"
                  }
                ]
              },
              {
                "key": "ShowTitle",
                "label": "Заголовок оверлея",
                "type": "boolean",
                "default": false
              },
              {
                "key": "OverlayTitleColor",
                "label": "Цвет заголовка",
                "type": "color",
                "default": "#d10404",
                "visibleIf": {
                  "ShowTitle": true
                }
              },
              {
                "key": "AlwaysShow",
                "label": "Всегда показывать",
                "type": "boolean",
                "default": false
              },
              {
                "key": "ShowDurationAfterLeavingPits",
                "label": "Время отображения после выезда из боксов (в сек.)",
                "type": "number",
                "default": 15,
                "min": 0,
                "max": 60,
                "step": 1
              },
              {
                "key": "ShowPitLimiter",
                "label": "Показывать ограничитель скорости",
                "type": "boolean",
                "default": true
              },
              {
                "key": "ShowPitSpeedDelta",
                "label": "Показывать дельту скорости",
                "type": "boolean",
                "default": true
              },
              {
                "key": "ShowPitStallDistance",
                "label": "Показывать дистанцию до пит-столла",
                "type": "boolean",
                "default": true
              },
              {
                "key": "PitBoxDetectionRange",
                "label": "Дальность до детекции пит-столла",
                "type": "number",
                "default": 200,
                "min": 20,
                "max": 1000,
                "step": 10,
                "unit": "м",
                "description": "С какого расстояния до пит-столла начинает заполняться индикатор дистанции.",
                "visibleIf": {
                  "ShowPitStallDistance": true
                }
              }
            ]
          }
        ]
      },
      {
        "id": "tires",
        "label": "Износ шин",
        "groups": [
          {
            "settings": [
              {
                "key": "ShowTireTemp",
                "label": "Показывать температуру шин",
                "type": "boolean",
                "default": true
              },
              {
                "key": "ShowTireWear",
                "label": "Показывать износ шин",
                "type": "boolean",
                "default": true
              },
              {
                "key": "PitTireWearVersion",
                "label": "Визуализация износа шин",
                "type": "select",
                "default": "OPACITY",
                "options": [
                  {
                    "value": "OPACITY",
                    "label": "Оттенки серого"
                  },
                  {
                    "value": "SIZED",
                    "label": "График"
                  },
                  {
                    "value": "COLORED",
                    "label": "Цвет"
                  },
                  {
                    "value": "COLORED_AND_SIZED",
                    "label": "Цвет и график"
                  }
                ],
                "visibleIf": {
                  "ShowTireWear": true
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "workshop": {
    "tags": [
      "Inputs"
    ],
    "visibility": "public"
  }
}
