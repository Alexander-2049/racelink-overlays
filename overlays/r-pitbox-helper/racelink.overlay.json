{
  "$schema": "./node_modules/@racelink/overlay/racelink-overlay.schema.json",
  "apiVersion": 2,
  "id": "r-pitbox-helper",
  "version": "1.0.0",
  "name": "R-Pitbox Helper",
  "category": "strategy",
  "description": "R-Pitbox Helper, the Racelink overlay, as a standalone overlay.",
  "entry": "index.html",
  "games": [
    "iracing",
    "le-mans-ultimate"
  ],
  "size": {
    "default": [
      166,
      230
    ],
    "min": [
      60,
      30
    ],
    "max": [
      664,
      920
    ]
  },
  "settings": {
    "pages": [
      {
        "id": "general",
        "label": "General",
        "groups": [
          {
            "settings": [
              {
                "key": "Opacity",
                "label": "Background opacity",
                "type": "number",
                "default": 0.6,
                "min": 0,
                "max": 1,
                "step": 0.05
              },
              {
                "key": "FontFamily",
                "label": "Font",
                "type": "select",
                "default": "Montserrat",
                "options": [
                  {
                    "value": "Montserrat",
                    "label": "Montserrat"
                  },
                  {
                    "value": "Roboto",
                    "label": "Roboto"
                  },
                  {
                    "value": "RobotoMono",
                    "label": "Roboto Mono"
                  },
                  {
                    "value": "TitilliumWeb",
                    "label": "Titillium Web"
                  },
                  {
                    "value": "Exo2",
                    "label": "Exo 2"
                  },
                  {
                    "value": "BarlowCondensed",
                    "label": "Barlow Condensed"
                  },
                  {
                    "value": "JetBrainsMono",
                    "label": "JetBrains Mono"
                  },
                  {
                    "value": "Geist",
                    "label": "Geist"
                  }
                ]
              },
              {
                "key": "FontWeight",
                "label": "Weight",
                "type": "select",
                "default": "Semibold",
                "options": [
                  {
                    "value": "Regular",
                    "label": "Regular"
                  },
                  {
                    "value": "Medium",
                    "label": "Medium"
                  },
                  {
                    "value": "Semibold",
                    "label": "Semibold"
                  },
                  {
                    "value": "Bold",
                    "label": "Bold"
                  },
                  {
                    "value": "Extra",
                    "label": "Extra bold"
                  }
                ]
              },
              {
                "key": "ShowTitle",
                "label": "Overlay header",
                "type": "boolean",
                "default": false
              },
              {
                "key": "OverlayTitleColor",
                "label": "Header colour",
                "type": "color",
                "default": "#d10404",
                "visibleIf": {
                  "ShowTitle": true
                }
              },
              {
                "key": "AlwaysShow",
                "label": "Always show",
                "type": "boolean",
                "default": false
              },
              {
                "key": "ShowDurationAfterLeavingPits",
                "label": "Display time after leaving the pits (s)",
                "type": "number",
                "default": 15,
                "min": 0,
                "max": 60,
                "step": 1
              },
              {
                "key": "ShowPitLimiter",
                "label": "Show the pit limiter",
                "type": "boolean",
                "default": true
              },
              {
                "key": "ShowPitSpeedDelta",
                "label": "Show the speed delta",
                "type": "boolean",
                "default": true
              },
              {
                "key": "ShowPitStallDistance",
                "label": "Show the distance to the pit stall",
                "type": "boolean",
                "default": true
              },
              {
                "key": "PitBoxDetectionRange",
                "label": "Pit stall detection range",
                "type": "number",
                "default": 200,
                "min": 20,
                "max": 1000,
                "step": 10,
                "unit": "m",
                "description": "The distance to the pit stall at which the distance indicator starts filling.",
                "visibleIf": {
                  "ShowPitStallDistance": true
                }
              }
            ]
          }
        ]
      },
      {
        "id": "tires",
        "label": "Tyre wear",
        "groups": [
          {
            "settings": [
              {
                "key": "ShowTireTemp",
                "label": "Show tyre temperature",
                "type": "boolean",
                "default": true
              },
              {
                "key": "ShowTireWear",
                "label": "Show tyre wear",
                "type": "boolean",
                "default": true
              },
              {
                "key": "PitTireWearVersion",
                "label": "Tyre wear display",
                "type": "select",
                "default": "OPACITY",
                "options": [
                  {
                    "value": "OPACITY",
                    "label": "Greyscale"
                  },
                  {
                    "value": "SIZED",
                    "label": "Chart"
                  },
                  {
                    "value": "COLORED",
                    "label": "Colour"
                  },
                  {
                    "value": "COLORED_AND_SIZED",
                    "label": "Colour and chart"
                  }
                ],
                "visibleIf": {
                  "ShowTireWear": true
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "workshop": {
    "tags": [
      "Inputs"
    ],
    "visibility": "public",
    "publishedFileId": "3828526077"
  }
}
