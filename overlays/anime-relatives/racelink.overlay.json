                "visibleIf": {
                  "mascotEnabled": true
                }
              },
              {
                "key": "reactBest",
                "label": "Your best laps (she dances)",
                "type": "boolean",
                "default": true,
                "visibleIf": {
                  "mascotEnabled": true
                }
              },
              {
                "key": "reactFinish",
                "label": "The chequered flag (dance party)",
                "type": "boolean",
                "default": true,
                "visibleIf": {
                  "mascotEnabled": true
                }
              }
            ]
          }
        ]
      }
    ]
  },
