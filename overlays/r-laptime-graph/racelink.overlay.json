{
  "$schema": "./node_modules/@racelink/overlay/racelink-overlay.schema.json",
  "apiVersion": 2,
  "id": "r-laptime-graph",
  "version": "1.0.0",
  "name": "R-LapTime Graph",
  "category": "timing",
  "description": "R-LapTime Graph, the Racelink overlay, as a standalone overlay.",
  "entry": "index.html",
  "games": [
    "iracing",
    "le-mans-ultimate",
    "assetto-corsa"
  ],
  "size": {
    "default": [
      450,
      300
    ],
    "min": [
      60,
      30
    ],
    "max": [
      1800,
      1200
    ]
  },
  "settings": {
    "pages": [
      {
        "id": "general",
        "label": "General",
        "groups": [
          {
            "settings": [
              {
                "key": "Opacity",
                "label": "Background opacity",
                "type": "number",
                "default": 0.75,
                "min": 0,
                "max": 1,
                "step": 0.05
              },
              {
                "key": "FontFamily",
                "label": "Font",
                "type": "select",
                "default": "Montserrat",
                "options": [
                  {
                    "value": "Montserrat",
                    "label": "Montserrat"
                  },
                  {
                    "value": "Roboto",
                    "label": "Roboto"
                  },
                  {
                    "value": "RobotoMono",
                    "label": "Roboto Mono"
                  },
                  {
                    "value": "TitilliumWeb",
                    "label": "Titillium Web"
                  },
                  {
                    "value": "Exo2",
                    "label": "Exo 2"
                  },
                  {
                    "value": "BarlowCondensed",
                    "label": "Barlow Condensed"
                  },
                  {
                    "value": "JetBrainsMono",
                    "label": "JetBrains Mono"
                  },
                  {
                    "value": "Geist",
                    "label": "Geist"
                  }
                ]
              },
              {
                "key": "FontWeight",
                "label": "Weight",
                "type": "select",
                "default": "Semibold",
                "options": [
                  {
                    "value": "Regular",
                    "label": "Regular"
                  },
                  {
                    "value": "Medium",
                    "label": "Medium"
                  },
                  {
                    "value": "Semibold",
                    "label": "Semibold"
                  },
                  {
                    "value": "Bold",
                    "label": "Bold"
                  },
                  {
                    "value": "Extra",
                    "label": "Extra bold"
                  }
                ]
              },
              {
                "key": "ShowTitle",
                "label": "Overlay header",
                "type": "boolean",
                "default": true
              },
              {
                "key": "OverlayTitleColor",
                "label": "Header colour",
                "type": "color",
                "default": "#d10404",
                "visibleIf": {
                  "ShowTitle": true
                }
              }
            ]
          }
        ]
      },
      {
        "id": "filters",
        "label": "Lap time filters",
        "groups": [
          {
            "settings": [
              {
                "key": "LimitLapCount",
                "label": "Limit the number of laps",
                "type": "boolean",
                "default": true,
                "description": "Limits the number of laps on the chart."
              },
              {
                "key": "LapCount",
                "label": "Laps to show",
                "type": "number",
                "default": 20,
                "min": 2,
                "max": 100,
                "step": 1,
                "visibleIf": {
                  "LimitLapCount": true
                }
              },
              {
                "key": "IsFilterOn",
                "label": "Lap time filter",
                "type": "boolean",
                "default": false,
                "description": "Removes extra laps from the chart: first laps, pit laps, out laps."
              },
              {
                "key": "FilterOutLower",
                "label": "Filter below (s)",
                "type": "number",
                "default": 5,
                "min": 0,
                "max": 60,
                "step": 0.5,
                "visibleIf": {
                  "IsFilterOn": true
                },
                "description": "Removes laps faster than the median by more than this many seconds."
              },
              {
                "key": "FilterOutHigher",
                "label": "Filter above (s)",
                "type": "number",
                "default": 5,
                "min": 0,
                "max": 60,
                "step": 0.5,
                "visibleIf": {
                  "IsFilterOn": true
                },
                "description": "Removes laps slower than the median by more than this many seconds."
              }
            ]
          }
        ]
      }
    ]
  },
  "workshop": {
    "tags": [
      "Inputs"
    ],
    "visibility": "public",
    "publishedFileId": "3828526158"
  }
}
